[global]
    background = "#2a2941"
    foreground = "#cdd6f4"
    frame_color = "#49598a"
    frame_width = 1
    corner_radius = 3
    transparency = 90
    font = JetBrainsMono Nerd Font 11
    padding = 8
    horizontal_padding = 8
    origin = top-right
    offset = (4, 10)


[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#602080"

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#602080"

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
